APCA_API_KEY_ID=your-paper-api-key
APCA_API_SECRET_KEY=your-paper-api-secret
TRADING_SYMBOL=your-stock-symbol
# Explicitly opt in to paid AI recommendations; hold makes no OpenAI calls.
DECISION_POLICY=hold
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_CYCLE_BUDGET_USD=0.05
# Program-owned dry-run weights (fractions of equity); order submission is disabled.
PLANNER_MAX_POSITION_WEIGHT=0.10
PLANNER_MAX_INVESTED_WEIGHT=0.80
PLANNER_MAX_ORDER_WEIGHT=0.02
PLANNER_QUOTE_MAX_AGE_SECONDS=60
