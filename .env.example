# Alpaca Markets 설정
# Paper Trading (무료 테스트용): https://paper-api.alpaca.markets
# Live Trading (실전):          https://api.alpaca.markets
ALPACA_BASE_URL=
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Google Gemini AI 설정
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash        # or gemini-1.5-pro

# 텔레그램 알림 설정
ENABLE_TELEGRAM=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# 트레이딩 설정
DRY_RUN=true                    # true: 알림만, false: 실제 주문
STRATEGY=AI                     # MA_CROSS, RSI, 또는 AI
TIMEFRAME=1Min                  # 차트 주기 (1Min, 5Min, 15Min, 1Day 등)
SYMBOL_LIST=AAPL,MSFT,NVDA      # 미국 주식 티커 (쉼표로 구분)
CHECK_INTERVAL_SECONDS=60       # 시세 조회 실행 주기 (초)
