# Alpaca Markets 설정
# Paper Trading (무료 테스트용): https://paper-api.alpaca.markets
# Live Trading (실전):          https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_API_KEY=
ALPACA_API_SECRET=

# 텔레그램 알림 설정
ENABLE_TELEGRAM=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# 트레이딩 설정
DRY_RUN=true                    # true: 알림만, false: 실제 주문
STRATEGY=MA_CROSS               # MA_CROSS 또는 RSI
SYMBOL_LIST=AAPL,MSFT,NVDA      # 미국 주식 티커 (쉼표로 구분)
CHECK_INTERVAL_SECONDS=60       # 시세 조회 주기 (초)
